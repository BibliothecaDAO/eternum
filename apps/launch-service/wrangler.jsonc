// The launch Worker. It serves /api/factory/* and /api/slots/* on the app's origin, beside identity, which owns the
// session it checks. The shard it launches on (SHARD_URL, its Herald), its registrar account
// (DEPLOYER_ACCOUNT_ADDRESS) and its launchers (LAUNCHER_ALLOWLIST) are the environment's GitHub variables, and
// DEPLOYER_PRIVATE_KEY and OPERATOR_TOKEN its secrets; the deploy workflow sets them. When Frontier and Blitz run is the
// season calendar in D1, which launchers edit. Production deploys only at the cutover, when the box's launch service stops: two schedulers
// would each freeze the same slots.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "realms-launch",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Registrar"] }],
  "env": {
    "staging": {
      "name": "realms-launch-staging",
      "workers_dev": false,
      "routes": [
        { "pattern": "staging.realms.party/api/factory/*", "zone_name": "realms.party" },
        { "pattern": "staging.realms.party/api/slots*", "zone_name": "realms.party" },
      ],
      "vars": { "ENVIRONMENT": "staging", "BASE_URL": "https://staging.realms.party" },
      "d1_databases": [{ "binding": "DB", "database_name": "realms-launch-staging", "migrations_dir": "migrations" }],
      "services": [{ "binding": "IDENTITY", "service": "realms-identity-staging" }],
      "durable_objects": { "bindings": [{ "name": "REGISTRAR", "class_name": "Registrar" }] },
      "triggers": { "crons": ["* * * * *"] },
      "version_metadata": { "binding": "VERSION" },
    },
    "production": {
      "name": "realms-launch",
      "workers_dev": false,
      "routes": [
        { "pattern": "play.realms.party/api/factory/*", "zone_name": "realms.party" },
        { "pattern": "play.realms.party/api/slots*", "zone_name": "realms.party" },
      ],
      "vars": { "ENVIRONMENT": "production", "BASE_URL": "https://play.realms.party" },
      "d1_databases": [
        { "binding": "DB", "database_name": "realms-launch-production", "migrations_dir": "migrations" },
      ],
      "services": [{ "binding": "IDENTITY", "service": "realms-identity" }],
      "durable_objects": { "bindings": [{ "name": "REGISTRAR", "class_name": "Registrar" }] },
      "triggers": { "crons": ["* * * * *"] },
      "version_metadata": { "binding": "VERSION" },
    },
  },
}

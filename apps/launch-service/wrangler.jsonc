// The launch Worker serves /api/factory/* and /api/slots/* on the app's origin.
// Its alarm joins directory shards; setup owns the device and operator secrets.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "realms-launch",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Registrar"] }],
  "env": {
    "staging": {
      "name": "realms-launch-staging",
      "workers_dev": false,
      "routes": [
        { "pattern": "play.dev-realms.party/api/factory/*", "zone_name": "dev-realms.party" },
        { "pattern": "play.dev-realms.party/api/slots*", "zone_name": "dev-realms.party" },
      ],
      "vars": { "ENVIRONMENT": "staging", "BASE_URL": "https://play.dev-realms.party" },
      "d1_databases": [{ "binding": "DB", "database_name": "realms-launch-staging", "migrations_dir": "migrations" }],
      "services": [
        { "binding": "IDENTITY_HTTP", "service": "realms-identity-staging" },
        { "binding": "IDENTITY", "service": "realms-identity-staging", "entrypoint": "ValueIdentity" },
        { "binding": "VALUE_RELAY", "service": "realms-value-relay-staging", "entrypoint": "ValueLaunch" },
      ],
      "durable_objects": { "bindings": [{ "name": "REGISTRAR", "class_name": "Registrar" }] },
      "triggers": { "crons": ["* * * * *"] },
      "version_metadata": { "binding": "VERSION" },
    },
    "production": {
      "name": "realms-launch",
      "workers_dev": false,
      "routes": [
        { "pattern": "play.realms.party/api/factory/*", "zone_name": "realms.party" },
        { "pattern": "play.realms.party/api/slots*", "zone_name": "realms.party" },
      ],
      "vars": { "ENVIRONMENT": "production", "BASE_URL": "https://play.realms.party" },
      "d1_databases": [
        { "binding": "DB", "database_name": "realms-launch-production", "migrations_dir": "migrations" },
      ],
      "services": [
        { "binding": "IDENTITY_HTTP", "service": "realms-identity" },
        { "binding": "IDENTITY", "service": "realms-identity", "entrypoint": "ValueIdentity" },
        { "binding": "VALUE_RELAY", "service": "realms-value-relay", "entrypoint": "ValueLaunch" },
      ],
      "durable_objects": { "bindings": [{ "name": "REGISTRAR", "class_name": "Registrar" }] },
      "triggers": { "crons": ["* * * * *"] },
      "version_metadata": { "binding": "VERSION" },
    },
  },
}

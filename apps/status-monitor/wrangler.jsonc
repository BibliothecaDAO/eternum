{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "realms-status-monitor",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": { "ENVIRONMENT": "production", "BASE_URL": "https://play.realms.party" },
  "observability": { "enabled": true },
  "r2_buckets": [{ "binding": "STATUS_BUCKET", "bucket_name": "realms-status" }],
  "env": {
    "staging": {
      "name": "realms-status-monitor-staging",
      "vars": { "ENVIRONMENT": "staging", "BASE_URL": "https://play.dev-realms.party" },
      "r2_buckets": [{ "binding": "STATUS_BUCKET", "bucket_name": "realms-status-staging" }],
    },
  },
  "triggers": { "crons": ["* * * * *"] },
}

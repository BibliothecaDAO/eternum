{
  "include": [
    "src/**/*.ts"
  ],
  "compilerOptions": {
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "lib": [
      "ES2022"
    ],
    "isolatedModules": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "types": [
      "@cloudflare/workers-types"
    ]
  }
}

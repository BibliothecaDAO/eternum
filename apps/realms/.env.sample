# apps/realms — copy into the repo-root .env (both the SPA and server load it
# through `pnpm with-env`). The value plane is mainnet from the start.

# ── client (Vite) ────────────────────────────────────────────────────────────
VITE_BASE_URL=https://realms.party
VITE_PUBLIC_GAME_ORIGIN=https://play.realms.party
# One mainnet RPC serves identity signing and value-plane reads (same chain).
VITE_PUBLIC_IDENTITY_RPC_URL=https://starknet-mainnet.example/rpc/v0_8

# ── identity server (server/main.ts, Bun) ────────────────────────────────────
# openssl rand -hex 32 — session signing; boot fails loudly without it.
BETTER_AUTH_SECRET=
DATABASE_URL=postgres://realms:realms@localhost:5432/realms
IDENTITY_RPC_URL=https://starknet-mainnet.example/rpc/v0_8
IDENTITY_COOKIE_DOMAIN=realms.party
# REALMS_SERVER_PORT=3001

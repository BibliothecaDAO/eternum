    "better-auth": "1.5.3",
    "drizzle-orm": "catalog:web",
    "effect": "4.0.0-rc.108",
    "react": "catalog:web",
    "react-dom": "catalog:web",
    "starknet": "catalog:web",
    "zod": "catalog:web"
  },
  "devDependencies": {
    "@realms-world/eslint-config": "workspace:*",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^22.19.13",
    "@types/react": "catalog:web",
    "@types/react-dom": "catalog:web",
    "bun-types": "^1.2.2",
    "@vitejs/plugin-react": "^4.7.0",
    "dotenv-cli": "catalog:web",
    "eslint": "catalog:web",
    "tailwindcss": "catalog:web",
    "typescript": "catalog:web",

{
  "name": "@realms-world/realms",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm with-env vite dev",
    "dev:server": "pnpm with-env bun run --watch server/main.ts",
    "start:server": "pnpm with-env bun run server/main.ts",
    "build": "pnpm with-env vite build",

# Chain configuration (mainnet or sepolia)
VITE_PUBLIC_CHAIN=mainnet

# Required: Alchemy API Key
# Get your free API key at: https://www.alchemy.com/
# The free tier includes:
# - 300M compute units/month
# - NFT API access
# - No credit card required
VITE_ALCHEMY_API_KEY=your_alchemy_api_key_here

# Optional: Other API keys
VITE_RESERVOIR_API_KEY=
VITE_DUNE_API_KEY=
VITE_ETHPLORER_APIKEY=

# Required: Public configuration
VITE_PUBLIC_SLOT=0

# Optional: URLs (defaults will be used if not provided)
VITE_BASE_URL=
VITE_PUBLIC_IMAGE_CDN_URL=
VITE_PUBLIC_IMAGE_PROXY_URL=
VITE_PUBLIC_IPFS_GATEWAY=
VITE_TORII_API_URL=
VITE_PUBLIC_NODE_URL=
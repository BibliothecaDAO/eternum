{
  "name": "eternum",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "pnpm test && vocs build -o ../dist && node scripts/ship-referenced-assets.mjs dist && node scripts/check-rendered-balance.mjs dist",
    "test": "node --test scripts/llm-txt.test.mjs scripts/ship-referenced-assets.test.mjs",
    "format": "npx prettier --write . --root=..",
    "format:check": "npx prettier --check . --root=..",
    "dev": "vocs dev",
    "preview": "vocs preview",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bibliothecadao/types": "workspace:*",
    "@types/react": "catalog:game",
    "@types/react-dom": "catalog:game",
    "fast-glob": "^3.3.3",
    "fumadocs-core": "^15.0.0",
    "fumadocs-mdx": "^11.6.0",
    "gray-matter": "^4.0.3",
    "react": "catalog:game",
    "react-dom": "catalog:game",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.0",
    "remark-stringify": "^11.0.0",
    "vite": "catalog:web",
    "vocs": "v1.0.0-alpha.57"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}

[
  {
    "name": "account/connect",
    "frame": "desktop",
    "setup": [
      {
        "open": "/lab/app/first-visit/connect/start?capture=1"
      },
      {
        "until": "document.documentElement.dataset.bootState === 'app-ready'",
        "ms": 120000
      },
      {
        "wait": 4000
      }
    ]
  },
  {
    "name": "account/code",
    "frame": "desktop",
    "setup": [
      {
        "open": "/lab/app/first-visit/connect/code?capture=1"
      },
      {
        "until": "document.documentElement.dataset.bootState === 'app-ready'",
        "ms": 120000
      },
      {
        "wait": 4000
      }
    ]
  },
  {
    "name": "account/name",
    "frame": "desktop",
    "setup": [
      {
        "open": "/lab/app/first-visit/connect/name?capture=1"
      },
      {
        "until": "document.documentElement.dataset.bootState === 'app-ready'",
        "ms": 120000
      },
      {
        "wait": 4000
      }
    ]
  },
  {
    "name": "account/payout-wallet",
    "frame": "panel",
    "setup": [
      {
        "open": "/lab/app/wallet-none/profile/settings?next=%2F&capture=1"
      },
      {
        "until": "document.documentElement.dataset.bootState === 'app-ready'",
        "ms": 120000
      },
      {
        "wait": 4000
      }
    ],
    "crop": "[...document.querySelectorAll('section.app-panel, section.app-window')].find((s) => s.querySelector('h2')?.textContent.trim() === 'Payout wallet')"
  },
  {
    "name": "frontier/explore",
    "frame": "desktop",
    "setup": [
      {
        "open": "/lab/studio?gameMode=frontier&clean=1&capture=1"
      },
      {
        "until": "document.querySelector('[data-studio-lab][data-ready=true]')",
        "ms": 180000
      },
      {
        "wait": 3000
      }
    ],
    "record": [
      {
        "eval": "window.__studio.take('explore')"
      },
      {
        "wait": 500
      }
    ],
    "seconds": 8
  },
  {
    "name": "account/settings",
    "frame": "panel",
    "setup": [
      {
        "open": "/lab/app/home/profile/settings?capture=1"
      },
      {
        "until": "document.documentElement.dataset.bootState === 'app-ready'",
        "ms": 120000
      },
      {
        "wait": 4000
      },
      {
        "click": "section[aria-label=\"Your wallet\"] .app-window__close",
        "optional": true
      },
      {
        "wait": 1000
      }
    ],
    "crop": "[...document.querySelectorAll('section.app-panel')].find((s) => s.querySelector('h2')?.textContent.trim() === 'Account')"
  },
  {
    "name": "frontier/realm-tiers",
    "frame": "desktop",
    "setup": [
      {
        "open": "/lab/studio?gameMode=frontier&clean=1&capture=1"
      },
      {
        "until": "document.querySelector('[data-studio-lab][data-ready=true]')",
        "ms": 180000
      },
      {
        "wait": 3000
      }
    ],
    "record": [
      {
        "eval": "window.__studio.take('realm-tiers')"
      },
      {
        "wait": 500
      }
    ],
    "seconds": 7
  },

  "directions": [
    {
      "id": "faceted",
      "name": "Facets",
      "description": "Broad painted planes, stronger light breaks and compact silhouettes."
    }
  ],
  "verdicts": {
    "faceted/stone": {
      "verdict": "beats shipped",
      "reason": "Pale fractured stone reads as rock at 32 px; lit planes and grain replace the jewel-like old facets."
    },
    "faceted/wood": {
      "verdict": "beats shipped",
      "reason": "Bark, cut end and end-grain hold at 64 px; a broad warm log silhouette remains at 32 px."
    },
    "faceted/wheat": {
      "verdict": "beats shipped",
      "reason": "Broader lit grain planes produce a stronger crop silhouette at 32 px; painted edges hold at 64 px."
    },
    "faceted/fish": {
      "verdict": "beats shipped",
      "reason": "Silver scales and a clear tail replace the bright blue polygon fish and its ground shadow."
    },
    "faceted/labor": {
      "verdict": "beats shipped",
      "reason": "A gripping hand and working hammer fill the square better than the distant full-body worker."
    },
    "faceted/essence": {
      "verdict": "equal",
      "reason": "The bottle remains clear at both sizes. Glass and violet volume improve at 64 px; the old magenta bottle is equally distinct at 32 px."
    },
    "faceted/ironwood": {
      "verdict": "equal",
      "reason": "Dense bark and red end-grain distinguish it from ordinary wood; the old black log has comparable contrast at 32 px."
    },
    "faceted/fragment": {
      "verdict": "equal",
      "reason": "The orange-green shard retains its identity; surface light improves at 64 px but the old silhouette is already strong."
    },
    "faceted/realm": {
      "verdict": "beats shipped",
      "reason": "Stone gate and slate roofs establish a material building instead of a monochrome gold token. Level remains an external badge."
    },
    "faceted/camp": {
      "verdict": "equal",
      "reason": "Both tents read at 32 px. The new canvas has stronger folds at 64 px without adding another visual object."
    },
    "faceted/hyperstructure": {
      "verdict": "beats shipped",
      "reason": "Stone spires and the lit core give the site material depth missing from the flat old emblem."
    },
    "faceted/chest": {
      "verdict": "beats shipped",
      "reason": "Wood and iron separate clearly at both sizes, replacing the all-gold chest with a readable object."
    },
    "faceted/move": {
      "verdict": "equal",
      "reason": "Leather boots retain material detail at 64 px. The old footprints are faster as a pure sign at 32 px."
    },
    "faceted/explore": {
      "verdict": "equal",
      "reason": "The map and lens have convincing depth; the old eye is simpler at 32 px. The map distinguishes this from a watch-only spyglass."
    },
    "faceted/attack": {
      "verdict": "equal",
      "reason": "A lit blade is clean and free of the old shield frame. Its narrow silhouette is less prominent but remains legible at 32 px."
    },
    "faceted/build": {
      "verdict": "equal",
      "reason": "The mallet and block match the shipped material quality; removing the second tool makes the 32 px subject cleaner."
    },
    "faceted/trade": {
      "verdict": "equal",
      "reason": "The iron balance keeps the familiar scale silhouette with clear pans. Small chains still merge at 32 px as in the old art."
    },
    "faceted/stamina": {
      "verdict": "equal",
      "reason": "Amber depth is stronger at 64 px; the old lightning silhouette is equally clear at 32 px. This meaning is reserved for stamina."
    },
    "faceted/victory": {
      "verdict": "beats shipped",
      "reason": "The silver trophy and green laurel have clearer volume than the flat old cup at 32 and 64 px."
    },
    "faceted/settings": {
      "verdict": "beats shipped",
      "reason": "One iron gear reads more clearly than the framed dial and key, with enough face shading to feel physical."
    },
    "faceted/chat": {
      "verdict": "beats shipped",
      "reason": "Two painted speech forms preserve the conversation meaning and remove the gold rim; ivory faces stay clear at 32 px."
    },
    "faceted/map-army": {
      "verdict": "equal",
      "reason": "An unframed helmet preserves a compact military silhouette; painted light replaces the old shield engraving."
    },
    "faceted/map-realm": {
      "verdict": "equal",
      "reason": "A broad gate and crenellations preserve the site silhouette while leaving ownership to the surrounding shape."
    },
    "faceted/knight-t1": {
      "verdict": "beats shipped",
      "reason": "Open face, mail and red neckcloth read at 24 px; the shipped full figure is much smaller. Plain helmet separates T1 from the closed T2 and crested T3."
    },
    "faceted/knight-t2": {
      "verdict": "beats shipped",
      "reason": "The approved armoured bust fills the square more clearly than the shipped figure. Closed steel helmet and red mantle sit between the open T1 and crested T3."
    },
    "faceted/knight-t3": {
      "verdict": "beats shipped",
      "reason": "Large red crest and layered shoulder plates survive 24 px reduction. Shipped tiers reuse the same small figure; this silhouette identifies the richest knight."
    },
    "faceted/crossbowman-t1": {
      "verdict": "beats shipped",
      "reason": "A visible face under a green hood and a held wooden crossbow replace the weapon-only study. The broad brown weapon and hood remain visible at 24 px."
    },
    "faceted/crossbowman-t2": {
      "verdict": "beats shipped",
      "reason": "Steel kettle helmet and plated shoulders separate this soldier from the hooded T1. The held crossbow remains clear; small face detail needs 32 px."
    },
    "faceted/crossbowman-t3": {
      "verdict": "beats shipped",
      "reason": "The large green crest, bright crossbow limbs and broad plate distinguish the veteran at 24 px. Shipped tiers have the same thin full-body silhouette."
    },
    "faceted/paladin-t1": {
      "verdict": "equal",
      "reason": "Ivory hood, visible face, upright sword and blue-white tabard read as a holy warrior. The shipped mounted figure remains a strong silhouette; this is a different close portrait."
    },
    "faceted/paladin-t2": {
      "verdict": "equal",
      "reason": "Winged steel helmet replaces the T1 hood while the sword and blue-white tabard preserve the type. Shipped mount is clearer as cavalry; the portrait is clearer as armour."
    },
    "faceted/paladin-t3": {
      "verdict": "equal",
      "reason": "White crest and bright layered plate enlarge the top silhouette at 24 px. Blue-white cloth and upright sword preserve the holy warrior identity without a shield."
    },
    "faceted/map-village": {
      "verdict": "beats shipped",
      "reason": "Paired red roofs distinguish village from the pale realm towers. The compact painted houses retain material at 32 px and roof colour at 12–16 px."
    },
    "faceted/map-mine": {
      "verdict": "beats shipped",
      "reason": "Dark opening and green crystal give mine a distinct colour mass. Fine pickaxe detail falls away at 12 px; the entrance and crystal carry the reading."
    }
  },

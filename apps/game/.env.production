# Tester build for play.realms.party — the self-run Madara lab appchain, Blitz, dev-mode.
# `vite build` reads this file; CI may override any value via the job env. Derived from
# apps/game/.env.madara.blitz.sample with the box's Cloudflare-tunnel hostnames.
VITE_PUBLIC_SHARD_URL=https://herald.realms.party
# Identity RPC is a public mainnet node the browser calls directly (SIWS signature verification), not proxied.
# VITE_PUBLIC_IDENTITY_RPC_URL is supplied by the CLIENT_IDENTITY_RPC_URL deployment secret.

VITE_PUBLIC_MARKETPLACE_URL=
VITE_PUBLIC_EXPLORER_URL=
VITE_PUBLIC_ENABLE_SQL_CACHE=false
VITE_PUBLIC_GAME_VERSION=athanor
VITE_PUBLIC_GRAPHICS_DEV=false
VITE_SOCIAL_LINK=https://bit.ly/3Zz1mpp
VITE_PUBLIC_LAUNCH_SERVICE_URL=https://launch.realms.party

# Tester build for play.realms.party — the self-run Madara lab appchain, Blitz, dev-mode.
# `vite build` reads this file; CI may override any value via the job env.
VITE_PUBLIC_FEE_TOKEN_ADDRESS=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d

# Chain + endpoints (the Madara lab behind the Cloudflare tunnel; identity RPC calls the public node directly)
VITE_PUBLIC_CHAIN=madara
VITE_PUBLIC_NODE_URL="https://rpc.realms.party"
VITE_PUBLIC_HERALD_URL="https://herald.realms.party"
VITE_PUBLIC_VRF_PROVIDER_ADDRESS="0x0"
VITE_PUBLIC_BINDING_AUTHORITY_ADDRESS="0x008a1719e7ca19f3d91e8ef50a48fc456575f645497a1d55f30e3781f786afe4"

# Launch service — the AWS Lambda is gone; games are launched by the deployer/harness on the box.
# Empty disables the client's launch button; the lobby still lists games from herald's directory.
VITE_PUBLIC_FACTORY_WORKER_URL=""

# Services that do not exist on the lab — empty disables the call paths
VITE_PUBLIC_REALTIME_URL=""
VITE_PUBLIC_ENABLE_SQL_CACHE="false"
VITE_PUBLIC_AMM_ROUTER_ADDRESS=""
VITE_PUBLIC_AMM_LORDS_ADDRESS=""
VITE_PUBLIC_AMM_INDEXER_URL=""
VITE_PUBLIC_CHEST_OPENING_ENABLED=false

# Render shape + noise
VITE_PUBLIC_WORLDMAP_ZOOM_HARDENING=true
VITE_PUBLIC_GRAPHICS_DEV=false

# Build identity — CI overrides GAME_VERSION with the release tag/sha
VITE_PUBLIC_GAME_VERSION="dev-local"
VITE_PUBLIC_SENTRY_ENVIRONMENT=madara-lab
VITE_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_PUBLIC_SENTRY_SEND_DEFAULT_PII=false

VITE_SOCIAL_LINK=http://bit.ly/3Zz1mpp

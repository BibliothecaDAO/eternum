# The client build for play.realms.party (Cloudflare Pages, deploy-client.yml). `vite build` reads this file; CI may
# override any value via the job env. No shard is named here: the app reads our directory at /api/directory and each
# shard's /manifest. VITE_PUBLIC_IDENTITY_RPC_URL, the mainnet RPC the linked wallet signs against, comes from the
# CLIENT_IDENTITY_RPC_URL secret (our Alchemy URL); the build fails without it and never falls back to a public node.

VITE_PUBLIC_EXPLORER_URL=
VITE_PUBLIC_GAME_VERSION=athanor
VITE_PUBLIC_GRAPHICS_DEV=false
VITE_SOCIAL_LINK=https://bit.ly/3Zz1mpp

# Tester build for play.jcndata.com — appchain-only, blitz-only (D3: eternum
# opens in phase 3 by adding VITE_PUBLIC_TORII_ETERNUM).
# `vite build` reads this file; CI may override any value via the job env.
VITE_PUBLIC_FEE_TOKEN_ADDRESS=0x49d36570d4e46f48e99674bd3fcc84644ddd6b96f7c741b1562b82f9e004dc7

# Chain + endpoints
VITE_PUBLIC_CHAIN=appchain
VITE_PUBLIC_NODE_URL="https://katana.jcndata.com"
VITE_PUBLIC_TORII="https://torii.jcndata.com"
VITE_PUBLIC_VRF_PROVIDER_ADDRESS="0x0"

# Launch service (Lambda dispatching game-launch.yml)
VITE_PUBLIC_FACTORY_WORKER_URL="https://t7wsbp6qsmvsbymew7kmnoo4i40qyqvh.lambda-url.us-east-1.on.aws"

# Services that do not exist on the appchain — empty disables the call paths
VITE_PUBLIC_REALTIME_URL=""
VITE_PUBLIC_ENABLE_SQL_CACHE="false"
VITE_PUBLIC_AMM_ROUTER_ADDRESS=""
VITE_PUBLIC_AMM_LORDS_ADDRESS=""
VITE_PUBLIC_AMM_INDEXER_URL=""
VITE_PUBLIC_CHEST_OPENING_ENABLED=false

# Sync shape + noise
VITE_PUBLIC_WORLDMAP_ZOOM_HARDENING=true
VITE_PUBLIC_TORII_BOUNDS_DEBUG=false
VITE_PUBLIC_GRAPHICS_DEV=false

# Build identity — CI overrides GAME_VERSION with the release tag/sha
VITE_PUBLIC_GAME_VERSION="dev-local"
VITE_PUBLIC_SENTRY_ENVIRONMENT=appchain-testers
VITE_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_PUBLIC_SENTRY_SEND_DEFAULT_PII=false

VITE_SOCIAL_LINK=http://bit.ly/3Zz1mpp

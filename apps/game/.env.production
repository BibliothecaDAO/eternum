# The client build for play.realms.party (Cloudflare Pages, published by the deployment command, deploy/first).
# `vite build` reads this file; the deployment command may override any value. No shard is named here: the app reads
# our directory at /api/directory and each shard's /manifest. The environment's L2 comes from its address book
# (VITE_PUBLIC_ENVIRONMENT, set by the deployment command). The build reads L2 through the free public endpoint in
# packages/chain (PUBLIC_L2_RPC_URL); the paid Alchemy URL never reaches a browser.

VITE_PUBLIC_GAME_VERSION=athanor
VITE_SOCIAL_LINK=https://bit.ly/3Zz1mpp

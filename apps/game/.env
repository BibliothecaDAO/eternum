# Default local environment: the client against the live lab stack (self-hosted Madara appchain,
# Herald, identity, launch service), so a fresh clone runs `pnpm dev` with no env setup. Personal
# overrides go in .env.local (gitignored) and always win over this file; tester builds layer
# .env.production on top.
VITE_PUBLIC_CHAIN=madara
VITE_PUBLIC_NODE_URL=https://rpc.realms.party
VITE_PUBLIC_IDENTITY_ORIGIN=https://app.realms.party
# Mainnet RPC the browser calls directly (identity session + Controller). This public endpoint is
# keyless and rate-limited, which is enough for development. The team's keyed Alchemy endpoint
# stays out of the repo: put it in .env.local as VITE_PUBLIC_IDENTITY_RPC_URL (tester builds get it
# from the CLIENT_IDENTITY_RPC_URL secret). Controller reuses it unless VITE_PUBLIC_CONTROLLER_RPC_URL is set.
VITE_PUBLIC_IDENTITY_RPC_URL=https://api.zan.top/public/starknet-mainnet

# Madara devnet fee token and gameplay-account contracts (from .lab/gameplay-contracts.json).
VITE_PUBLIC_FEE_TOKEN_ADDRESS=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d
VITE_PUBLIC_PLAYER_ACCOUNT_CLASS_HASH=0x05085c5c53efdc762c7c0637c92eecaf962aa3d72774b38faf3b8852c1729093
VITE_PUBLIC_PLAYER_REGISTRY_ADDRESS=0x047d5db2930b9a3270d9cb0e31e3eed2645602c5b51419207f730f3a7f8fafe0
VITE_PUBLIC_BINDING_AUTHORITY_ADDRESS=0x008a1719e7ca19f3d91e8ef50a48fc456575f645497a1d55f30e3781f786afe4
VITE_PUBLIC_VRF_PROVIDER_ADDRESS=0x0
VITE_PUBLIC_CHAT_URL=https://chat.realms.party
VITE_PUBLIC_MARKETPLACE_URL=
VITE_PUBLIC_EXPLORER_URL=
VITE_PUBLIC_ENABLE_SQL_CACHE=false
VITE_PUBLIC_GAME_VERSION=madara-lab
VITE_PUBLIC_GRAPHICS_DEV=false
VITE_SOCIAL_LINK=https://bit.ly/3Zz1mpp
VITE_PUBLIC_HERALD_URL=https://herald.realms.party
VITE_PUBLIC_LAUNCH_SERVICE_URL=https://launch.realms.party

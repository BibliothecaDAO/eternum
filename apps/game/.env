# Default local environment. Personal values go in .env.local (gitignored), which always wins over this file;
# tester builds layer .env.production on top.
# The environment's one L2 is never committed either: VITE_PUBLIC_L2_CHAIN names it (SN_SEPOLIA for the dev environment,
# SN_MAIN for production) and VITE_PUBLIC_IDENTITY_RPC_URL is the team's keyed Alchemy URL for that same chain. Set
# both in .env.local for development; deployed builds take them from the CLIENT_L2_CHAIN variable and the
# CLIENT_IDENTITY_RPC_URL secret. The dev server and the build refuse to start without either.

VITE_PUBLIC_EXPLORER_URL=
VITE_PUBLIC_GAME_VERSION=athanor
VITE_PUBLIC_GRAPHICS_DEV=false
VITE_SOCIAL_LINK=https://bit.ly/3Zz1mpp

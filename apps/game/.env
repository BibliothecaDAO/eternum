# Default local environment. Personal values go in .env.local (gitignored), which always wins over this file;
# tester builds layer .env.production on top.
# The environment's L2 comes from its address book (contracts/common/addresses): a dev build is on Sepolia, a build with
# VITE_PUBLIC_ENVIRONMENT=production on mainnet. VITE_PUBLIC_IDENTITY_RPC_URL, the team's keyed Alchemy URL for that
# chain, is never committed: set it in .env.local for development; deployed builds take it from the
# CLIENT_IDENTITY_RPC_URL secret. The dev server and the build refuse to start without it.

VITE_PUBLIC_EXPLORER_URL=
VITE_PUBLIC_GAME_VERSION=athanor
VITE_PUBLIC_GRAPHICS_DEV=false
VITE_SOCIAL_LINK=https://bit.ly/3Zz1mpp

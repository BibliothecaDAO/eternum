# Default local environment. Personal values go in .env.local (gitignored), which always wins over this file;
# tester builds layer .env.production on top.
# VITE_PUBLIC_IDENTITY_RPC_URL, the mainnet RPC the browser calls for identity and Controller, is never committed:
# it is the team's keyed Alchemy URL, set in .env.local for development and from the CLIENT_IDENTITY_RPC_URL secret
# for deployed builds. The dev server and the build refuse to start without it.

VITE_PUBLIC_EXPLORER_URL=
VITE_PUBLIC_GAME_VERSION=athanor
VITE_PUBLIC_GRAPHICS_DEV=false
VITE_SOCIAL_LINK=https://bit.ly/3Zz1mpp

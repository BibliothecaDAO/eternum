  "reductions": [
    "Remove village count and slot state; settlement passes bound production village count.",
    "Store structure base fields in one packed slot instead of ten independent slots, preserving their ranges.",
    "Store each guard's eight boost fields in one packed slot, shared with explorer troop storage.",
    "Reuse structure ownership, resource facts and the one-time troop-grant flag.",
    "Remove the duplicate stored and projected structure category; the base owns it.",
    "Derive structure existence from its nonzero category instead of a second map.",
    "Pack troop count, stamina, boosts and combat flags into four slots with unchanged field ranges.",
    "Separate settlement allocation and entitlement from ordered execution; share one typed internal settlement-creation command."
  ],
  "ruledDivergences": [
    {
      "fact": "Village placement and capacity",
      "oracle": "Direction consumes one of six realm slots.",
      "native": "One village per production pass through the single-structure planner pool, without realm entry consumption.",
      "cause": "Frozen village ruling.",
      "projection": "The oracle connection is placed two hexes west of the native planner-selected tile. Native planner inputs and pool remain unchanged. The same position lets grants, production, biome and army outcomes remain paired."
    },
    {
      "fact": "Army grant state",
      "oracle": "VillageTroop.claimed is separate from StructureBase.starting_troops_granted.",
      "native": "The existing Structure flag records the single grant.",
      "cause": "One authoritative eligibility fact.",
      "projection": "The oracle fact projection reads VillageTroop.claimed for a village; it does not mutate oracle storage."
    }
  ],

  "reductions": [
    "Move the compiled canonical realm table into immutable deployment configuration shared by games.",
    "Remove the Wonder mirror; realm identity, position and wonder eligibility already belong to Structure.",
    "Reuse the existing settlement planner and sparse resource facts instead of a second realm state representation.",
    "Remove the allocation-player map and row: no gameplay or client reader used it, and a consumed reverse index enforces the same reservation guard without a second ownership fact."
  ],
  "ruledDivergences": [
    {
      "fact": "Settlement neighbour visibility",
      "oracle": "Realm provisioning reveals neighbouring biomes; Eternum settlement also reveals village-slot tiles.",
      "native": "Realm and village settlement reveal only their own tile. All neighbouring native tiles must equal their pre-action state.",
      "cause": "Frozen village and reveal ruling.",
      "projection": "The paired action snapshots native neighbours before execution and asserts their complete state is unchanged afterwards. Own-tile facts and every other gameplay fact remain paired."
    }

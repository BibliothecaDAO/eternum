  "ruledDivergences": [
    {
      "id": "duplicate-transfer-resources",
      "cause": "The pinned arrival accumulator can spend 10 + 20 but queue 20 + 20 for a newly arriving resource; malformed duplicate input creates resources.",
      "rule": "Reject duplicate resource ids in every transfer before gameplay mutation. An authenticated current-nonce ticket records rejection and consumes its nonce and order.",
      "oracle": "Retain the pinned defect in the oracle; compare native facts with the unchanged pre-action facts for this rejected input.",
      "cases": [
        {
          "name": "resources_duplicates",
          "oracle": true,
          "native": false
        }
      ]
    },
    {
      "id": "village-reinforcement",
      "cause": "Village placement is independent of its connected realm; that connection does not define troop-transfer eligibility.",
      "rule": "Remove connected-realm ownership checks for incoming village troops. Adjacent reinforcement has the same eligibility in both modes; Eternum accepts allied reinforcement previously rejected.",
      "oracle": "Keep the pinned Eternum rejection and assert the native transfer against the declared reinforcement facts. Generic transport mode rules remain separate.",
      "cases": [
        {
          "name": "resources_village_eternum",
          "oracle": false,
          "native": true
        }
      ]
    }

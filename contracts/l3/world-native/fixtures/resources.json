  "ownedFacts": [
    "Per-entity resource balances and carrying capacity/weight.",
    "Production building count, rate, remaining prepaid output and settlement time.",
    "Per-resource approvals between structures.",
    "Ordered resources awaiting a destination arrival slot."
  ],
  "requiredConfig": [
    "Game settling, main and grace boundaries and recorded execution time.",
    "Immutable unit weights, donkey capacity, donkey speed, troop speed and tick lengths.",
    "Structure ownership, location and category; explorer home, location, layer, stamina and combat cooldown.",
    "Village immunity; incoming troops have no connected-realm eligibility predicate."
  ],
  "parityRequirements": [
    "All 58 resource types retain their balance ranges and relic precision.",
    "LORDS and relics have zero production without rejecting valid balance mutations.",
    "Production uses recorded elapsed seconds, current rate and prepaid cap; food remains uncapped.",
    "Capacity truncation and overflow/underflow rejections match the oracle.",
    "Production is settled before spending or granting; failed spending changes no gameplay fact.",
    "Views do not settle or write production.",
    "Approval requires source ownership, a distinct owned destination and a nonempty list.",
    "Pickup consumes finite allowances and preserves unlimited approvals.",
    "Delayed transfers retain travel timing, donkey costs, mode restrictions and arrival order.",
    "Offloading retains slot availability, partial-prefix limits and capacity behavior.",
    "Adjacent transfers retain layer, adjacency, ownership and troop restrictions.",
    "Burning and regularization retain season, ownership and weight rules.",
    "Explicit burns and weight regularization do not settle production; resource actions retain the inclusive grace deadline.",
    "Explorer actions authorize the agent owner only for the reserved agent home; other explorers use their structure owner.",
    "Adjacent transfers spend the requested amount even when recipient capacity stores only part of it.",
    "Every transfer rejects duplicate resource ids atomically, including nonadjacent duplicates and zero amounts; ticket order and current actor nonce advance on rejection.",
    "Village reinforcement never consults connected-realm ownership; source authorization, adjacency, layers and resource limits still apply."
  ],
  "normalization": [
    "Entity/account identities map bijectively; recorded execution time is oracle block time.",
    "Inactive production has no accrual timestamp: both projections return zero when building_count is zero. Activation settles at the recorded command time before enabling production; an oracle fixture covers delayed activation."
  ],
  "reductions": [
    "Pack the existing 232 production bits into one storage felt instead of four slots.",
    "Settle and apply each resource mutation in memory, then persist the final facts once.",
    "Eliminate the 48-field arrival selector table; represent only populated slots with their original ordered list.",
    "Remove inactive production timestamps and their rows; the activation command establishes the clock before enabling accrual."
  ],

+
+#[derive(Deserialize)]
+struct TestProgram {
+    #[serde(rename = "version")]
+    _version: Version<1>,
+    type_declarations: Vec<TypeDeclaration>,
+    libfunc_declarations: Vec<LibfuncDeclaration>,
+    statements: Vec<Statement>,
+    funcs: Vec<Function>,
+    debug_info: Option<DebugInfo>,
+}
+
+impl TestProgram {
+    fn into_program(self) -> ProgramArtifact {
+        ProgramArtifact {
+            program: Program {
+                type_declarations: self.type_declarations,
+                libfunc_declarations: self.libfunc_declarations,
+                statements: self.statements,
+                funcs: self.funcs,
+            },
+            debug_info: self.debug_info,
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use cairo_lang_sierra::program::VersionedProgram;
+
+    #[test]
+    fn test_artifact_reader_preserves_program_and_debug_information() {
+        let value = serde_json::json!({
+            "version": 1,
+            "type_declarations": [{"id": {"id": 0, "debug_name": "felt252"}, "long_id": {"generic_id": "felt252", "generic_args": []}, "declared_type_info": null}],
+            "libfunc_declarations": [{"id": {"id": 0, "debug_name": "felt252_const<1>"}, "long_id": {"generic_id": "felt252_const", "generic_args": [{"Value": [1, [1]]}]}}],
+            "statements": [{"Return": [{"id": 0}]}],
+            "funcs": [{"id": {"id": 0, "debug_name": "test::one"}, "signature": {"param_types": [], "ret_types": [{"id": 0, "debug_name": "felt252"}]}, "params": [], "entry_point": 0}],
+            "debug_info": {"type_names": [], "libfunc_names": [], "user_func_names": [], "executables": {"snforge_internal_test_executable": [{"id": 0, "debug_name": "test::one"}]}, "annotations": {"test.example/v1": {"nested": [1, "value", null]}}}
+        });
+        let bytes = serde_json::to_vec(&value).unwrap();
+        let expected = serde_json::from_slice::<VersionedProgram>(&bytes)
+            .unwrap()
+            .into_v1()
+            .unwrap();
+        let actual = serde_json::from_reader::<_, TestProgram>(bytes.as_slice())
+            .unwrap()
+            .into_program();
+        assert_eq!(actual, expected);
+    }
+
+    #[test]
+    fn test_artifact_reader_rejects_unsupported_versions_and_incomplete_programs() {
+        for value in [
+            serde_json::json!({"version": 2, "type_declarations": [], "libfunc_declarations": [], "statements": [], "funcs": []}),
+            serde_json::json!({"version": 1, "type_declarations": []}),
+        ] {
+            assert!(serde_json::from_value::<TestProgram>(value).is_err());
+        }
+    }
+}

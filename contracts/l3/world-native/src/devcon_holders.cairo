fn contains_holder(holders: Span<felt252>, target: felt252) -> bool {
    let mut found = false;
    for holder in holders {
        if *holder == target {
            found = true;
            break;
        }
    }
    found
}

pub fn holds_golden_devcon(owner: ContractAddress) -> bool {
    contains_holder(GOLDEN_DEVCON_HOLDERS.span(), owner.into())
}

pub fn holds_regular_devcon(owner: ContractAddress) -> bool {
    contains_holder(REGULAR_DEVCON_HOLDERS.span(), owner.into())
}

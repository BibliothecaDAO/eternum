# ENV PRESET COMMON TO BOTH SEASON PASS AND SEASON RESOURCES DEPLOYMENT
# STARKNET_RPC is never committed: set a keyed sepolia RPC URL in the repo-root .env (loaded after this file by every
# contract task) or in your shell. Tasks refuse to run without it.
export STARKNET_NETWORK=sepolia
export STARKNET_ACCOUNT_ADDRESS=0x01BFC84464f990C09Cc0e5D64D18F54c3469fD5c467398BF31293051bAde1C39
# STARKNET_ACCOUNT_PRIVATE_KEY is never committed: export it in your shell before a task. The file leaves it unset so
# sourcing it keeps your value.
export DEPLOYMENT_ADDRESSES_FOLDER=addresses/sepolia

# SEASON RESOURCE ONLY ENV
export SEASON_RESOURCE_ADMIN=0x01BFC84464f990C09Cc0e5D64D18F54c3469fD5c467398BF31293051bAde1C39

# SEASON PASS ONLY ENV
export SEASON_PASS_ADMIN=0x01BFC84464f990C09Cc0e5D64D18F54c3469fD5c467398BF31293051bAde1C39
export SEASON_PASS_PRESET_REALMS_ADDRESS=0
export SEASON_PASS_PRESET_LORDS_ADDRESS=0



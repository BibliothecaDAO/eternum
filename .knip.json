{
  "ignoreDependencies": [],
  "ignore": [
    "**/*.js",
    "apps/game-docs/vocs.config.ts",
    "apps/game-docs/docs/**",
    "apps/game-docs/vite-plugin-llm-txt.mjs",
    "apps/game-docs/env.ts",
    "scripts/codemod-lucide-imports.mjs",
    "config/generated/**",
    "contracts/**",
    "**/global.d.ts"
  ],
  "ignoreFiles": [
    "apps/amm-indexer/apibara.config.ts",
    "apps/amm-indexer/indexers/ammv2.indexer.ts",
    "apps/amm-indexer/indexers/factory-client.ts"
  ],
  "ignoreWorkspaces": [
    "packages/ammv2-sdk"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "deploy/athanor/scripts/host-accounts.ts",
        "deploy/release/facts.ts",
        "deploy/athanor/scripts/inspect-shard-roles.ts",
        "deploy/athanor/scripts/read-rpc.ts",
        "deploy/athanor/scripts/account-rpc-smoke.ts",
        "deploy/athanor/scripts/enrol-operator.ts"
      ],
      "paths": {
        "@bibliothecadao/eternum": [
          "packages/core/src/index.ts"
        ]
      }
    },
    "apps/launch-service": {
      "entry": [
        "src/worker.ts"
      ],
      "ignoreDependencies": [
        "cloudflare"
      ],
      "paths": {
        "@bibliothecadao/eternum/shard": [
          "../../packages/core/src/client/shard-reader.ts"
        ]
      }
    },
    "packages/identity": {
      "entry": [
        "src/index.ts",
        "src/account.ts"
      ]
    },
    "apps/guardian": {
      "entry": [
        "src/worker.ts"
      ],
      "ignoreDependencies": [
        "cloudflare"
      ]
    },
    "apps/realms": {
      "entry": [
        "server/worker.ts"
      ],
      "ignoreDependencies": [
        "cloudflare"
      ],
      "ignore": [
        "dist/**"
      ],
      "paths": {
        "@bibliothecadao/eternum/expeditions": [
          "../../packages/core/src/utils/expeditions.ts"
        ],
        "@bibliothecadao/eternum/troop-stamina": [
          "../../packages/core/src/managers/troop-stamina.ts"
        ]
      }
    },
    "apps/indexer": {
      "drizzle": false,
      "entry": [
        "apibara.config.ts",
        "indexers/*.indexer.ts",
        "scripts/check-realm-ownership-indexer.mjs"
      ]
    },
    "packages/db": {
      "drizzle": false
    },
    "packages/core": {
      "project": [
        "src/**/*.ts"
      ],
      "includeEntryExports": true,
      "paths": {
        "@bibliothecadao/provider": [
          "../provider/src/index.ts"
        ],
        "@bibliothecadao/types": [
          "../types/src/index.ts"
        ],
        "@bibliothecadao/types/terrain": [
          "../types/src/terrain.ts"
        ]
      }
    },
    "packages/provider": {
      "project": [
        "src/**/*.ts"
      ],
      "includeEntryExports": true,
      "paths": {
        "@bibliothecadao/types": [
          "../types/src/index.ts"
        ]
      }
    },
    "packages/types": {
      "project": [
        "src/**/*.ts"
      ],
      "includeEntryExports": true
    },
    "apps/game": {
      "paths": {
        "@bibliothecadao/eternum": [
          "../../packages/core/src/index.ts"
        ],
        "@bibliothecadao/eternum/automation": [
          "../../packages/core/src/automation/index.ts"
        ],
        "@bibliothecadao/eternum/game-entity-keys": [
          "../../packages/core/src/managers/game-entity-keys.ts"
        ],
        "@bibliothecadao/eternum/game-sync": [
          "../../packages/core/src/sync/index.ts"
        ],
        "@bibliothecadao/eternum/game-client": [
          "../../packages/core/src/client/index.ts"
        ],
        "@bibliothecadao/provider": [
          "../../packages/provider/src/index.ts"
        ],
        "@bibliothecadao/types": [
          "../../packages/types/src/index.ts"
        ],
        "@bibliothecadao/types/terrain": [
          "../../packages/types/src/terrain.ts"
        ],
        "@bibliothecadao/eternum/biome": [
          "../../packages/core/src/utils/biome/biome.ts"
        ],
        "@bibliothecadao/eternum/shard": [
          "../../packages/core/src/client/shard-reader.ts"
        ]
      }
    },
    "apps/herald": {
      "paths": {
        "@bibliothecadao/eternum/game-sync": [
          "../../packages/core/src/sync/index.ts"
        ],
        "@bibliothecadao/eternum/game-sync-models": [
          "../../packages/core/src/sync/model-manifest.ts"
        ],
        "@bibliothecadao/eternum/expeditions": [
          "../../packages/core/src/utils/expeditions.ts"
        ]
      }
    },
    "apps/game-docs": {
      "paths": {
        "@bibliothecadao/types": [
          "../../packages/types/src/index.ts"
        ]
      }
    },
    "config": {
      "entry": [
        "deployer/clean/cli/create.ts",
        "deployer/clean/cli/deploy-world.ts",
        "deployer/clean/registrar/register-preset.ts",
        "utils/utils.ts"
      ]
    }
  },
  "ignoreIssues": {
    "apps/web/**": [
      "exports",
      "types"
    ],
    "apps/web/src/gql/snapshot/graphql.ts": [
      "exports",
      "types"
    ],
    "apps/game/src/three/three-webgpu-type-guard.ts": [
      "files",
      "types"
    ],
    "!(packages)/**": [
      "classMembers"
    ],
    "packages/!(provider)/**": [
      "classMembers"
    ],
    "apps/game/src/services/amm/*.ts": [
      "files"
    ]
  },
  "rules": {
    "classMembers": "error"
  },
  "include": [
    "classMembers"
  ]
}

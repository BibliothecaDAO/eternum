# Stock Torii v1.8.16, pinned to the persistent s2 world.
rpc = "{RPC_URL}"
db_dir = "{DB_DIR}"

[indexing]
events_chunk_size = 1024
blocks_chunk_size = 10240
pending = true
polling_interval = 250
controllers = true
pre_confirmed = true
max_concurrent_tasks = 100
transactions = true

contracts = [
  "WORLD:{WORLD_ADDRESS}",
]

namespaces = ["s2"]
world_block = 0

[erc]
max_metadata_tasks = 10

[events]
raw = true

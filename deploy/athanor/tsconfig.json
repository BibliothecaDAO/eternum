{
  "extends": "../../packages/tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM"
    ],
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "types": [
      "bun-types",
      "node"
    ]
  },
  "include": [
    "harness/**/*.ts",
    "scripts/**/*.ts",
    "../release/**/*.ts",
    "vrf/**/*.ts",
    "../first/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}

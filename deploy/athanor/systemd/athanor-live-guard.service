[Unit]
Description=Record live health beside native candidate load
RequiresMountsFor=/opt/athanor

[Service]
Type=simple
Restart=on-failure
ExecStart=/usr/bin/python3 /opt/athanor/eternum/deploy/athanor/scripts/candidate_guard.py
MemoryMax=128M
CPUQuota=5%
StandardOutput=append:/opt/athanor/logs/live-guard.jsonl
StandardError=append:/opt/athanor/logs/live-guard.jsonl

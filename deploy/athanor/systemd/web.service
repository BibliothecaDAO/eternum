# apps/web: identity (SIWS, better-auth over Postgres) and the gameplay-account binding authority. It must run
# somewhere with the authority key; on the server profile that is the box, behind app.<LAB_DOMAIN>.
# Installed by scripts/bootstrap-server.sh into /etc/systemd/system/web.service.
# Redeploy: git pull && pnpm --dir apps/web build && sudo systemctl restart web
[Unit]
Description=Realms web (identity + binding authority, :3000)
After=network-online.target docker.service herald.service
Wants=network-online.target

[Service]
User=realms
WorkingDirectory=/opt/realms/eternum
Environment=PORT=3000
Environment=PATH=/home/realms/.bun/bin:/usr/local/bin:/usr/bin:/bin
# env resolves pnpm from PATH — NodeSource installs it at /usr/bin, not /usr/local/bin.
ExecStart=/usr/bin/env pnpm --dir apps/web start
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

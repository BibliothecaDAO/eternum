# TLS front for every browser-facing host of the lab. Browsers are the only TLS clients; sozo, the deployer,
# the harness and probes talk plain HTTP to the host services directly (README "Bring the chain up").
#
# One wildcard certificate, issued by scripts/issue-certs.sh from the mkcert root that the game's Vite plugin
# already installed in the system trust store — one CA for the whole lab.
{
	auto_https off
	admin off
}

(lab_tls) {
	tls /certs/realms.test.pem /certs/realms.test-key.pem
}

# apps/web dev server (plain HTTP on the host)
realms.test {
	import lab_tls
	reverse_proxy host.docker.internal:3000 {
		# Preserve the browser's Host: Vite checks it (allowedHosts) on the HMR websocket path and
		# rejects the docker-internal upstream name with a 400, which sends the client into a reload loop.
		header_up Host {host}
	}
}

# apps/game dev server (Vite mkcert plugin serves HTTPS on the host; the hop is loopback, so its cert is not checked)
play.realms.test {
	import lab_tls
	reverse_proxy https://host.docker.internal:5173 {
		# Preserve the browser's Host (see the web block above) — verified 2026-08-26: without it the
		# HMR upgrade reaches Vite with the docker-internal Host and is refused 400.
		header_up Host {host}
		transport http {
			tls_insecure_skip_verify
		}
	}
}

# herald (apps/herald on the host, HTTP + WebSocket on :3003): the game's read path.
herald.realms.test {
	import lab_tls
	reverse_proxy host.docker.internal:3003 {
		header_up Host {host}
	}
}

rpc.realms.test {
	import lab_tls
	reverse_proxy madara:9944
}

# Public Starknet mainnet node for Sign-In-With-Starknet verification from the browser (paths pass through, so
# /rpc/v0_9 selects the spec version on the upstream). Server-side verification calls the upstream directly.
identity-rpc.realms.test {
	import lab_tls
	reverse_proxy {$IDENTITY_RPC_UPSTREAM} {
		header_up Host {upstream_hostport}
	}
}

# apps/launch-service owns Madara game launches and their durable queue.
# The owner supplies registrar credentials and LAUNCHER_ALLOWLIST in the root .env.
[Unit]
Description=Realms box-native launch service (:3006)
After=network-online.target docker.service herald.service realms-identity.service
Wants=network-online.target

[Service]
User=realms
WorkingDirectory=/opt/realms/eternum
Environment=PATH=/home/realms/.bun/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/opt/realms/eternum/.env
Environment=PORT=3006
Environment=DATABASE_URL=postgres://realms:realms@127.0.0.1:5432/eternum_launch
Environment=IDENTITY_URL=http://127.0.0.1:3000
Environment=CORS_ORIGIN=https://play.realms.party,https://eternum-game.pages.dev
Environment=HERALD_URL=http://127.0.0.1:3003
Environment=GAME_MANIFEST_PATH=/opt/realms/eternum/contracts/l3/game/manifest_madara.json
ExecStart=/usr/bin/env pnpm --dir apps/launch-service start
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

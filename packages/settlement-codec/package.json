{
  "name": "@bibliothecadao/settlement-codec",
  "version": "0.1.0",
  "description": "Canonical Eternum settlement protocol codecs and schema registry",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "check:economic-interface-schema": "node ../../scripts/settlement/generate-economic-interface-schema.mjs --check",
    "generate:economic-interface-schema": "node ../../scripts/settlement/generate-economic-interface-schema.mjs",
    "check:package-lock-matrix": "node ../../scripts/settlement/generate-package-lock-matrix.mjs --check",
    "generate:package-lock-matrix": "node ../../scripts/settlement/generate-package-lock-matrix.mjs",
    "check:deployment-identity-vector": "tsx ../../scripts/settlement/generate-deployment-identity-vector.ts --check",
    "generate:deployment-identity-vector": "tsx ../../scripts/settlement/generate-deployment-identity-vector.ts",
    "check:authority-inventory": "tsx ../../scripts/settlement/generate-authority-inventory.mjs --check",
    "generate:authority-inventory": "tsx ../../scripts/settlement/generate-authority-inventory.mjs",
    "verify:authority-observation": "node ../../scripts/settlement/verify-authority-observation.mjs",
    "verify:authority-source-rebuild": "node ../../scripts/settlement/verify-authority-source-rebuild.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "starknet": "catalog:"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.4.4",
    "vitest": "^3.0.0"
  }
}

{
  "name": "@bibliothecadao/notifications",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --target es2022 --format esm,cjs --dts",
    "build:email-art": "node scripts/build-email-art.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "catalog:web",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "effect": "4.0.4"
  }
}

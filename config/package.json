{
  "name": "eternum-config-deploy",
  "scripts": {
    "madara:blitz": "if [ -f ../apps/game/.env.madara.blitz ]; then bun --env-file=../apps/game/.env.madara.blitz run ./deployer/index.ts madara blitz; else bun --env-file=../apps/game/.env.madara.blitz.sample run ./deployer/index.ts madara blitz; fi",
    "appchain:blitz": "bun --env-file=../apps/game/.env.appchain.blitz run ./deployer/index.ts appchain blitz",
    "sync:madara:blitz": "bun run ./scripts/run-sync.ts madara blitz",
    "sync:appchain": "bun run ./scripts/run-sync.ts appchain",
    "sync:appchain:blitz": "bun run ./scripts/run-sync.ts appchain blitz",
    "sync:appchain:eternum": "bun run ./scripts/run-sync.ts appchain eternum",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@bibliothecadao/eternum": "workspace:*",
    "@bibliothecadao/provider": "workspace:*",
    "@bibliothecadao/types": "workspace:*",
    "@dojoengine/core": "catalog:game",
    "@realms-world/chain": "workspace:*",
    "chalk": "^5.4.1",
    "viem": "catalog:game",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "starknet": "8.5.2",
    "typescript": "^5.0.0"
  }
}
